{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Dushanbe",
  "schedule": ["before 9am on Monday"],
  "labels": ["dependencies"],
  "baseBranches": ["main"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchPackageNames": ["react", "react-dom"],
      "groupName": "React core"
    },
    {
      "matchPackageNames": ["vite", "@vitejs/plugin-react", "@tailwindcss/vite", "tailwindcss"],
      "groupName": "Vite + Tailwind toolchain"
    },
    {
      "matchPackageNames": ["@tanstack/react-query", "@tanstack/react-query-devtools"],
      "groupName": "TanStack Query"
    },
    {
      "matchPackageNames": ["typescript", "typescript-eslint", "eslint", "@eslint/js"],
      "groupName": "TypeScript + ESLint"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackagePrefixes": ["Microsoft.EntityFrameworkCore", "Npgsql"],
      "groupName": "EF Core + Npgsql"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackagePrefixes": ["SkiaSharp"],
      "groupName": "SkiaSharp"
    }
  ],
  "ignorePaths": ["**/node_modules/**", "**/dist/**", "**/bin/**", "**/obj/**"]
}
