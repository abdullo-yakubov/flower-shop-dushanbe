# Copy to .env and fill in real values. .env is gitignored.
# Used by docker-compose.yml (start-docker.ps1).

# PostgreSQL
POSTGRES_USER=flowershop
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=flowershop

# JWT — required, at least 32 characters (API refuses to start otherwise)
JWT_SECRET_KEY=change_me_at_least_32_characters_long_secret
JWT_ISSUER=flowershop
JWT_AUDIENCE=flowershop-app

# SMS: mock (code 123456, printed to the API log) | eskiz (not implemented yet)
SMS_PROVIDER=mock
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173
