# Copy this file to .env and fill in your values
# .env is gitignored

# PostgreSQL
POSTGRES_USER=flowershop
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=flowershop

# JWT
JWT_SECRET_KEY=change_me_at_least_32_characters_long_secret
JWT_ISSUER=flowershop
JWT_AUDIENCE=flowershop-app

# SMS (Eskiz.uz)
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=your@email.com
ESKIZ_PASSWORD=your_eskiz_password

# MinIO
MINIO_USER=minioadmin
MINIO_PASSWORD=change_me_minio_password

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
